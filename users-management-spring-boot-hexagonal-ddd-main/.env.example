# Server Configuration
PORT=3000

# Database Configuration (MySQL or PostgreSQL)
# DB_TYPE: 'mysql' (default) or 'postgres'
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crud_usuarios
DB_USERNAME=root
DB_PASSWORD=123
# Or provide the full connection URL directly:
# DB_URL=jdbc:mysql://host:port/database?useSSL=true

# SMTP Configuration (JavaMail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password
SMTP_FROM_ADDRESS=tu_correo@gmail.com
SMTP_FROM_NAME=Gestion de Usuarios

# RabbitMQ Configuration (Local or Cloud: CloudAMQP / Railway / Render)
# Format: amqp://user:password@host:port/vhost or amqps://...
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE_USER_EVENTS=user.exchange
RABBITMQ_ROUTING_KEY_USER_CREATED=user.created
RABBITMQ_ROUTING_KEY_USER_UPDATED=user.updated

